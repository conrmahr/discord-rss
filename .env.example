REDIS_URL=
# prefix for this app's redis keys
DATABASE_NAME=
# required to post; without it the web ui still works but the runner stays off
DISCORD_WEBHOOK_URL=
# optional overrides of the web ui: leave commented out to let the ui decide (a new install
# starts paused; resume it from the web ui). uncommented, they need a valid value or they're
# ignored with an error in the log.
# minutes between checks, 1-1440
# INTERVAL=15
# true/false forces the runner on/off, overriding the ui's pause/resume
# RUNNER_ENABLED=true
# On UNIX systems you can use `openssl rand -hex 32` or 
# https://generate-secret.vercel.app/32 to generate a secret.
AUTH_SECRET=
AUTH_DISCORD_CLIENT_ID=
AUTH_DISCORD_CLIENT_SECRET=
DISCORD_AUTHORIZED_USERS=
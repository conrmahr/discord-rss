REDIS_URL=
# prefix for this app's redis keys
DATABASE_NAME=
# required to post; without it the web ui still works but the runner stays off
DISCORD_WEBHOOK_URL=
# optional: overrides the interval set in the web ui (minutes, 1-1440)
INTERVAL=
# optional: true/false forces the runner on/off and overrides the web ui's pause/resume.
# unset: a new install starts paused (resume it from the web ui); always off in `pnpm dev`
RUNNER_ENABLED=
# On UNIX systems you can use `openssl rand -hex 32` or 
# https://generate-secret.vercel.app/32 to generate a secret.
AUTH_SECRET=
AUTH_DISCORD_CLIENT_ID=
AUTH_DISCORD_CLIENT_SECRET=
DISCORD_AUTHORIZED_USERS=